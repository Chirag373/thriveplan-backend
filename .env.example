# Local defaults work without these first three values.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=sqlite:///db.sqlite3
# Production: DJANGO_SETTINGS_MODULE=config.settings.production and PostgreSQL DATABASE_URL.
FIREBASE_PROJECT_ID=your-firebase-project-id
# Absolute path to a service-account JSON outside the repository, or use workload ADC.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Web API key from the SAME Firebase project; required to send reset emails.
FIREBASE_WEB_API_KEY=your-firebase-web-api-key

# General emails: console locally; use django.core.mail.backends.smtp.EmailBackend to deliver.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=ThrivePlan <noreply@example.com>
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
